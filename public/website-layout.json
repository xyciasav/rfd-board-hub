          "kind": "text",
          "default": {
            "id": "472c96102a2a4f87",
            "title": "Dignity and Inclusion for All",
            "subtitle": "",
            "body": "We stand with immigrants, communities of color, and all those who face discrimination or exclusion. Everyone deserves dignity, respect, and the opportunity to belong. We celebrate the diversity of our communities and believe everyone should have a voice and a place at the table.",
