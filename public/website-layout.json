        },
        {
          "key": "e42a85152f8dc0ed",
          "section": "pages",
          "label": "Civic Education",
          "kind": "text",
          "default": {
            "id": "e42a85152f8dc0ed",
            "title": "Civic Education",
            "subtitle": "",
            "body": "Our movement is rooted in solidarity. When someone gets knocked down, we help lift them up. We look out for one another, make space for one another, and refuse to leave people behind. We believe strong communities are built through care, courage, and collective action.",
            "link": "https://www.ragefordemocracy.com/what-we-stand-for.html#acf5562a",
            "image": "",
            "date": "",
            "visible": true,
