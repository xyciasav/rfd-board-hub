        {
          "key": "4c2200f909eae3ed",
          "section": "pages",
          "label": "Transparency and Justice",
          "kind": "text",
          "default": {
            "id": "4c2200f909eae3ed",
            "title": "Transparency and Justice",
            "subtitle": "",
            "body": "We believe in transparency, accountability, and equal justice under the law. We stand with survivors of abuse and with all people who have too often been ignored, silenced, or failed by powerful institutions. Justice should never depend on wealth, status, or political connections.",
            "link": "https://www.ragefordemocracy.com/what-we-stand-for.html#2150f970",
            "image": "",
            "date": "",
            "visible": true,
            "order": 60
