        },
        {
          "key": "472c96102a2a4f87",
          "section": "pages",
          "label": "Support for Immigrants and Communities of Color",
          "kind": "text",
          "default": {
            "id": "472c96102a2a4f87",
            "title": "Support for Immigrants and Communities of Color",
            "subtitle": "",
            "body": "We stand with immigrants and communities of color in our region. Every person deserves dignity, respect, and equal treatment, regardless of where they come from or the color of their skin. We reject fear, division, and scapegoating, and we believe our communities are strongest when everyone is protected, included, and able to participate fully.",
            "link": "https://www.ragefordemocracy.com/what-we-stand-for.html#63a7aa08",
            "image": "",
            "date": "",
            "visible": true,
            "order": 70
